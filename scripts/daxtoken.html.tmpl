<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>$name #$token_id · Daxchain</title>
    <meta name="description" content="$description">
    <link rel="canonical" href="$canonical">
    <link rel="icon" href="/logo.png" type="image/png">
    <meta name="theme-color" content="#050607">
    <link rel="stylesheet" href="/daxtoken/token.css">
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Daxchain home">
        <img src="/logo.png" width="40" height="40" alt="">Daxchain
      </a>
    </header>
    <main>
      <section aria-labelledby="token-name">
        <h1 id="token-name">$name <span>#$token_id</span></h1>
        <p>$description</p>
        <dl>
          <dt>Token contract</dt>
          <dd><code>$contract</code></dd>
        </dl>
        <a class="metadata" href="$metadata_url">View token metadata</a>
      </section>
      <img class="artwork" src="/daxtoken/0/artwork.png" width="512" height="512"
           alt="Three yellow, orange, and red cubes inside a turquoise ring with four green nodes">
    </main>
  </body>
</html>
